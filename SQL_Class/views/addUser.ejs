<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add a new user</title>
    <style>
        body{
            background-color: black;
            color: white;
        }
    </style>
</head>

<body> 
    <h2>Add new user auto</h2>
    <form action="/user/addnewauto" method="post">
        <button>Add a user ! </button>
    </form>
    <h2>Add new user manually</h2>
    <form action="/user/adduserman" method="post">
        id:
        <input type="text" name="id" placeholder="Enter unique id here" required> <br><br>
        username: 
        <input type="text" name="username" placeholder="Enter username here" required><br><br>
        Email: 
        <input type="email" name="email" placeholder="Enter Email here" required><br><br>
        Password:
        <input type="password" name="password" placeholder="Enter Password here" required><br><br>
        <button>Add it ! </button>
    </form>
    
</body>
</html>