<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>newChat</title>
    <link rel="stylesheet" href="/style.css">
    
  </head>
  <body>
    <h3>Write new chat..</h3>
    <div class="newChat">
      <form action="/chats" method="post">
        <input
          type="text"
          placeholder="Write your name here"
          name="from"
        /><br /><br />
        <textarea name="msg" id="" placeholder="Write Message here"></textarea
        ><br /><br />
        <input
          type="text"
          placeholder="Enter recivers name here"
          name="to"
        /><br /><br />
        <button class="btn">Send</button>
      </form>
    </div>
  </body>
</html>
